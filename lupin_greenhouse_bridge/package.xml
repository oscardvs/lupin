<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lupin_greenhouse_bridge</name>
  <version>0.0.1</version>
  <description>ROS 2 wrapper around the mdp-greenhouse course simulator. Exposes a GetTagReading service that returns sensor measurements for a given greenhouse tag.</description>
  <maintainer email="o.a.e.devos@student.tudelft.nl">Team Lupin</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>builtin_interfaces</depend>
  <depend>lupin_msgs</depend>

  <!--
    The mdp-greenhouse Python package is not in rosdistro. Primary install is
    via setup.py install_requires; python3-pip is the fallback for environments
    where pip-driven dependency resolution is bypassed.
  -->
  <exec_depend>python3-pip</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
