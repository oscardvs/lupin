<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lupin_mission</name>
  <version>0.0.1</version>
  <description>Mission orchestrator for Team Lupin's MIRTE Master. Drives the
    tag-scanning routine end-to-end: navigate to each known greenhouse tag
    via Nav2, query the greenhouse bridge for sensor readings at each one,
    and log the results.</description>
  <maintainer email="o.a.e.devos@student.tudelft.nl">Team Lupin</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>lupin_msgs</depend>

  <!--
    The mdp-greenhouse Python package is not in rosdistro; we only use it to
    read the bundled tag_locations.json (coordinates of each greenhouse tag).
    Primary install is via setup.py install_requires; pip is the fallback for
    rosdep-driven environments.
  -->
  <exec_depend>python3-pip</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
