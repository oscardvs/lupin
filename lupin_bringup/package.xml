<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lupin_bringup</name>
  <version>1.1.0</version>
  <description>Top-level launch files, params, and system glue for MDP Team Lupin.</description>
  <maintainer email="o.a.e.devos@student.tudelft.nl">Team Lupin</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>mirte_gazebo</exec_depend>
  <!-- sim_full.launch.py composes these. Listed as exec_depends so rosdep
       installs them, but this isn't a hard fail if a teammate runs only a
       subset of the chain. -->
  <exec_depend>lupin_navigation</exec_depend>
  <exec_depend>lupin_greenhouse_bridge</exec_depend>
  <exec_depend>lupin_mission</exec_depend>
  <exec_depend>lupin_web</exec_depend>
  <exec_depend>lupin_perception</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <!-- cameras.launch.py spawns web_video_server on the robot so raw camera
       frames never cross WiFi (matches vendor mirte.local/ros-video/). -->
  <exec_depend>web_video_server</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
