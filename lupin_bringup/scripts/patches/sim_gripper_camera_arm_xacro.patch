diff --git a/mirte_description/mirte_master_description/urdf/arm.xacro b/mirte_description/mirte_master_description/urdf/arm.xacro
index c0380a0..e7a3be0 100644
--- a/mirte_description/mirte_master_description/urdf/arm.xacro
+++ b/mirte_description/mirte_master_description/urdf/arm.xacro
@@ -584,6 +584,91 @@
 
 
 
+<!-- Gripper camera: sim mirror of the real Mirte usb_cam publishing /gripper_camera/*.
+     Mounted on the rigid `wrist` so it does not move with the jaw mimic joint. -->
+<link name="gripper_camera_link">
+    <inertial>
+        <origin xyz="0 0 0" rpy="0 0 0"/>
+        <mass value="0.005"/>
+        <inertia ixx="1.0e-7" ixy="0" ixz="0" iyy="1.0e-7" iyz="0" izz="1.0e-7"/>
+    </inertial>
+    <visual>
+        <origin xyz="0 0 0" rpy="0 0 0"/>
+        <geometry>
+            <box size="0.025 0.040 0.012"/>
+        </geometry>
+        <material name="gripper_camera_mat">
+            <color rgba="0.05 0.05 0.05 1"/>
+        </material>
+    </visual>
+    <collision>
+        <origin xyz="0 0 0" rpy="0 0 0"/>
+        <geometry>
+            <box size="0.025 0.040 0.012"/>
+        </geometry>
+    </collision>
+</link>
+
+<joint name="gripper_camera_joint" type="fixed">
+    <origin xyz="0.040 0 0.025" rpy="0 0.40 0"/>
+    <parent link="wrist"/>
+    <child link="gripper_camera_link"/>
+</joint>
+
+<!-- ROS optical frame (Z forward, Y down, X right). gripper_camera_link's
+     +X is the camera viewing axis (the mount joint above pitches it ~0.40 rad
+     down toward the pot); this joint rotates that into the standard optical
+     convention so the published image header frame is well-formed. -->
+<joint name="gripper_camera_optical_joint" type="fixed">
+    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
+    <parent link="gripper_camera_link"/>
+    <child link="gripper_camera_optical_frame"/>
+</joint>
+<link name="gripper_camera_optical_frame"/>
+
+<!-- Gazebo RGB camera sensor — sim mirror of the real gripper usb_cam.
+     Publishes /gripper_camera/image_raw + /gripper_camera/camera_info at
+     30 Hz with frame_id gripper_camera_optical_frame. The per-pot arm
+     'inspect' pose aims this at the bloom for the HSV flower detector.
+     The flower's MAP position is the co-located tag's pose (temporal
+     association in perception_aggregator), so this camera only needs to
+     render the bloom — exact calibration is not required.
+     NOTE: this block was previously removed while bisecting a
+     gazebo_ros2_control CLI-parse issue. If the arm/base controllers fail
+     to spawn after restoring it, this sensor is the prime suspect. -->
+<gazebo reference="gripper_camera_link">
+    <sensor name="gripper_camera" type="camera">
+        <visualize>false</visualize>
+        <update_rate>30</update_rate>
+        <camera name="gripper_camera">
+            <horizontal_fov>1.0472</horizontal_fov>
+            <image>
+                <width>640</width>
+                <height>480</height>
+                <format>R8G8B8</format>
+            </image>
+            <clip>
+                <near>0.05</near>
+                <far>10.0</far>
+            </clip>
+        </camera>
+        <!-- IMPORTANT: do NOT add a ros remapping (with a ":=" rule) here.
+             gazebo_ros2_control passes the whole URDF to controller_manager as a
+             "param robot_description" CLI override, and a ":=" anywhere inside the
+             URDF breaks that override parser, so controller_manager never starts.
+             The body Astra avoids this by naming topics via the camera name only;
+             we do the same. camera_name (no ":=") yields /gripper_camera/image_raw
+             and /gripper_camera/camera_info. -->
+        <plugin name="gripper_camera_controller" filename="libgazebo_ros_camera.so">
+            <camera_name>gripper_camera</camera_name>
+            <alwaysOn>true</alwaysOn>
+            <updateRate>30</updateRate>
+            <frame_name>gripper_camera_optical_frame</frame_name>
+        </plugin>
+    </sensor>
+</gazebo>
+
+
 <gazebo>
     <plugin filename="libgazebo_grasp_fix.so" name="gazebo_grasp_fix">
        <arm>
