[Unit]
Description=Lupin onboard nodes (twist_mux + arm_preset_server + gripper_action_bridge)
Documentation=https://gitlab.tudelft.nl/cor/ro47007/2026/group_14/lupin
# These nodes connect HMI commands to the mirte_ros controllers and gripper
# action server. They must come up after the controllers are loaded but they
# also tolerate the controllers appearing late (the action client retries).
After=mirte-ros.service network-online.target
Wants=mirte-ros.service network-online.target
PartOf=mirte-ros.service

[Service]
Type=simple
User=mirte
Group=mirte
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source /home/mirte/mirte_ws/install/setup.bash && source /home/mirte/ros2_ws/install/setup.bash 2>/dev/null; exec ros2 launch lupin_bringup onboard.launch.py'
Restart=on-failure
RestartSec=4
MemoryMax=256M
ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lupin-onboard

[Install]
WantedBy=multi-user.target
