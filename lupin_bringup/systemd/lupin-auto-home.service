[Unit]
Description=Move arm to 'home' preset at boot (low-load rest pose)
Documentation=https://gitlab.tudelft.nl/cor/ro47007/2026/group_14/lupin
# Run after lupin-onboard so arm_preset_server is up and joint_state_broadcaster
# has been spawned. PartOf=mirte-ros so a vendor service restart re-fires this
# unit alongside the rest of the stack.
After=lupin-onboard.service
Wants=lupin-onboard.service
PartOf=mirte-ros.service
# Bounds on the Restart=on-failure policy below. systemd 230+ expects these
# in [Unit] rather than [Service]; we're on systemd 249 (Ubuntu 22.04 jammy).
StartLimitBurst=4
StartLimitIntervalSec=240

[Service]
Type=oneshot
RemainAfterExit=yes
User=mirte
Group=mirte
# Mirte settings sourced for LUPIN_AUTO_HOME=false opt-out.
ExecStart=/bin/bash -lc 'source /home/mirte/.mirte_settings.sh; \
  source /opt/ros/humble/setup.bash; \
  source /home/mirte/mirte_ws/install/setup.bash; \
  source /home/mirte/ros2_ws/install/setup.bash 2>/dev/null; \
  exec ros2 run lupin_hmi auto_home'
# Boot-time race: if the discovery server fails to bind, or mirte-ros is
# slow to spawn controller_manager (the documented
# project_mirte_ros_discovery_server_cold_boot_race), auto_home exits
# non-zero after its internal 30s timeout. Retry on failure with a short
# backoff so the second/third attempt — by which point mirte-ros has
# settled — picks up the heal. Capped at StartLimitBurst attempts so a
# truly-wedged stack doesn't loop forever (operator will recover via
# post-boot-sync.sh anyway, which reset-failed + start's this unit).
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lupin-auto-home

[Install]
WantedBy=multi-user.target
